# Engineer Baah — Production VPS Environment Configuration
# Copy this file to `.env` on your VPS (`.env` is git-ignored and protected by .htaccess)

# 1. Authenticated SMTP Configuration (Recommended: Gmail App Password or VPS Mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=engineerbaah25@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM=engineerbaah25@gmail.com
SMTP_FROM_NAME="Engineer Baah Website"

# Destination inbox for form enquiries (defaults to engineerbaah25@gmail.com)
NOTIFY_EMAIL=engineerbaah25@gmail.com

# 2. Optional: Custom Inquiry Storage Directory (outside public web root)
# EB_STORAGE_PATH=/var/www/storage/engineerbaah

# 3. Optional: Real-time Webhook URL (Slack / Discord / Telegram / Zapier)
# CONTACT_WEBHOOK_URL=
