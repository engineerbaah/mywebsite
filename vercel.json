{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/robots.txt",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/sitemap.xml"
    },
    {
      "src": "/(favicon.*|apple-touch-icon.*)",
      "dest": "/assets/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}

